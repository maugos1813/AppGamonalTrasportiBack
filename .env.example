# Servidor
PORT=4000
NODE_ENV=development

# CORS - origenes permitidos separados por coma (ej: https://app.com,https://admin.app.com)
CORS_ORIGIN=*

# Base de datos - Neon PostgreSQL
# Formato: postgresql://usuario:password@host/db?sslmode=require
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Recuperacion de contrasena
RESET_TOKEN_EXPIRES_MINUTES=30
RESET_PASSWORD_URL=http://localhost:5173/reset-password

# Resend (envio de emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="RegistrosGT <no-reply@tudominio.com>"

# Cloudflare R2 (almacenamiento de documentos, bucket privado)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_SIGNED_URL_EXPIRES_SECONDS=900

# Geocodificacion (Nominatim) y ruteo (OSRM) - servidores publicos gratuitos
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GamonalTrasporti/1.0 (maufabagosgam@gmail.com)
OSRM_BASE_URL=https://router.project-osrm.org
